{
  "name": "figr-frontend-assignment",
  "private": true,
  "description": "Starter kit for the Figr frontend engineer assignment",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "postinstall": "npm --prefix frontend install",
    "backend": "node backend/server.js",
    "dev": "concurrently \"npm run backend\" \"npm run frontend\"",
    "frontend": "cd frontend && npm run dev"
  },
  "dependencies": {
    "concurrently": "^10.0.5"
  }
}
